# =============================================================================
# Database
# =============================================================================
DATABASE_URL=

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Firebase (client)
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# =============================================================================
# Firebase (server / admin)
# Optional: use GOOGLE_APPLICATION_CREDENTIALS instead of explicit service account
# =============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
# GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# Cloudflare R2 (S3-compatible storage)
# =============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=
# Optional Cloudflare Image Resizing width for vision downloads (default 1568; set 0 to disable)
R2_IMAGE_RESIZE_WIDTH=1568

# =============================================================================
# Facebook (Messenger / Pages)
# =============================================================================
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Arbitrary string you enter in the Meta App Dashboard when subscribing the webhook
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# =============================================================================
# Secret encryption (OAuth tokens, cookies)
# 32-byte key, base64-encoded — generate with: openssl rand -base64 32
# =============================================================================
SECRET_DATA_ENCRYPTION_KEY=

# =============================================================================
# Upstash QStash (background jobs)
# =============================================================================
QSTASH_TOKEN=
# Required for /api/qstash/callback signature verification
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional override; defaults to NEXT_PUBLIC_APP_URL/api/qstash/callback
QSTASH_CALLBACK_URL=

# =============================================================================
# Upstash Redis (cache / coordination)
# =============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# AI / LangChain
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith tracing (optional — auto-enables LANGCHAIN_TRACING_V2 when set)
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=bnb-chat-agent

# Default chat model for agents (optional)
# CHAT_AGENT_MODEL=claude-sonnet-4-6

# =============================================================================
# Knowledge base / Pinecone / Firecrawl
# =============================================================================
PINECONE_API_KEY=
PINECONE_INDEX_NAME=bnb-kb-multilingual-e5
# Default region for npm run kb:setup-index (AWS Singapore — nearest to Vietnam)
# PINECONE_REGION=ap-southeast-1
FIRECRAWL_API_KEY=
# Optional classifier override for chunk strategy (defaults to claude-haiku-4-5)
# KNOWLEDGE_BASE_CLASSIFIER_MODEL=claude-haiku-4-5
# Optional model for KB search query rewrite / multi-query (defaults to classifier model)
# KNOWLEDGE_BASE_QUERY_STRATEGY_MODEL=claude-haiku-4-5
